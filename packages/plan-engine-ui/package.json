{
  "name": "@bkg/plan-engine-ui",
  "version": "0.1.0",
  "description": "BKG Plan Engine - React UI components, themes, and hooks",
  "author": "BKG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bkg/bkg-extensions.git",
    "directory": "packages/plan-engine-ui"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.js --outdir dist --target node",
    "dev": "bun run build --watch",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.1.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}