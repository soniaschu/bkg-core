{
  "name": "@bkg/plan-engine-server",
  "version": "0.1.0",
  "description": "BKG Plan Engine - Server for plan review, annotation, and agent communication",
  "author": "BKG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bkg/bkg-extensions.git",
    "directory": "packages/plan-engine-server"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "dev": "bun run build --watch",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bkg/plan-engine-core": "workspace:*",
    "@bkg/plan-engine-shared": "workspace:*",
    "@plannotator/ai": "workspace:*",
    "@plannotator/shared": "workspace:*",
    "@opencode-ai/sdk": "^1.3.0",
    "@pierre/diffs": "^1.3.5",
    "chokidar": "^5.0.0",
    "diff": "^8.0.4",
    "dompurify": "^3.3.3",
    "marked": "^17.0.0",
    "sonner": "^2.0.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.1.0",
    "typescript": "^5.6.0",
    "jsdom": "^25.0.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}